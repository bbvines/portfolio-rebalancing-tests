<?xml version="1.0" encoding="UTF-8"?>
<configuration>

  <!-- ── Console Appender ────────────────────────────────────────────── -->
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
    </encoder>
  </appender>

  <!-- ── File Appender – writes to target/logs/test.log ─────────────── -->
  <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>target/logs/test.log</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
      <!-- New log file created daily; keeps last 7 days -->
      <fileNamePattern>target/logs/test.%d{yyyy-MM-dd}.log</fileNamePattern>
      <maxHistory>7</maxHistory>
    </rollingPolicy>
    <encoder>
      <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
    </encoder>
  </appender>

  <!-- ── Project loggers – DEBUG level for full test visibility ──────── -->
  <logger name="com.crd.rebalancing" level="DEBUG" additivity="false">
    <appender-ref ref="CONSOLE"/>
    <appender-ref ref="FILE"/>
  </logger>

  <!-- ── Third-party loggers – WARN only to keep output clean ────────── -->
  <logger name="org.openqa.selenium"         level="WARN"/>
  <logger name="io.github.bonigarcia"        level="WARN"/>
  <logger name="io.qameta.allure"            level="WARN"/>
  <logger name="org.testng"                  level="WARN"/>

  <!-- ── Root logger ─────────────────────────────────────────────────── -->
  <root level="INFO">
    <appender-ref ref="CONSOLE"/>
    <appender-ref ref="FILE"/>
  </root>

</configuration>
